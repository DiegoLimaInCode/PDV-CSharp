<UserControl
    x:Class="PDVCSharp.WPF.Controls.ProductThumb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="52"
    Height="52">
    <Grid>
        <Border
            Background="#D7E3F4"
            CornerRadius="6">
            <TextBlock
                x:Name="LetterText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrandBlue}" />
        </Border>
        <Border CornerRadius="6" ClipToBounds="True">
            <Image
                x:Name="Photo"
                Stretch="UniformToFill" />
        </Border>
    </Grid>
</UserControl>
