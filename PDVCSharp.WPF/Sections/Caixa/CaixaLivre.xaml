<UserControl
    x:Class="PDVCSharp.WPF.Sections.Caixa.CaixaLivre"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PDVCSharp.WPF.Controls">
    <DockPanel Background="{StaticResource PageBackground}">
        <controls:AppHeader Title="Caixa livre" DockPanel.Dock="Top" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}" Text="SUPERMARKET" />
            <TextBlock Margin="0,8,0,4" FontSize="34" FontWeight="SemiBold" Text="Caixa livre" />
            <TextBlock Margin="0,0,0,6" FontSize="15" Foreground="{StaticResource TextMuted}" Text="{Binding OperatorName, StringFormat=Operador: {0}}" />
            <TextBlock Margin="0,0,0,24" FontSize="15" Foreground="{StaticResource TextMuted}" Text="{Binding ValorAberturaTexto}" />

            <UniformGrid Columns="2" Rows="2">
                <Button Margin="0,0,8,8" Height="72" Click="BtnIniciarVenda_Click" Content="Nova venda" Style="{StaticResource PrimaryButton}" />
                <Button Margin="8,0,0,8" Height="72" Click="BtnEstoque_Click" Content="Estoque" Style="{StaticResource GhostButton}" />
                <Button Margin="0,8,8,0" Height="72" Click="BtnHistorico_Click" Content="Histórico" Style="{StaticResource GhostButton}" />
                <Button Margin="8,8,0,0" Height="72" Click="BtnFechamento_Click" Content="Fechar caixa" Style="{StaticResource DangerButton}" />
            </UniformGrid>
        </StackPanel>
    </DockPanel>
</UserControl>
