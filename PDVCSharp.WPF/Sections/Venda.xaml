<UserControl
    x:Class="PDVCSharp.WPF.Sections.Venda"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PDVCSharp.WPF.Controls">
    <DockPanel Background="{StaticResource PageBackground}">
        <controls:AppHeader Title="Venda" DockPanel.Dock="Top" />
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                <TextBlock FontSize="22" FontWeight="Bold" Text="Venda em andamento" />
                <TextBlock Foreground="{StaticResource TextMuted}" Text="{Binding OperatorName, StringFormat=Operador: {0}}" />
            </StackPanel>

            <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Catálogo" />
                <TextBox
                    x:Name="TxtBusca"
                    DockPanel.Dock="Top"
                    KeyDown="TxtBusca_KeyDown"
                    Style="{StaticResource FieldBox}"
                    Margin="0,8,0,8"
                    Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" />
                <ListBox ItemsSource="{Binding Catalogo}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Background="White" BorderBrush="#E2E6EC" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:ProductThumb ImagePath="{Binding ImagePath}" ProductName="{Binding Name}" />
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}">
                                            <Run Text="{Binding Sku}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Categoria}" />
                                        </TextBlock>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Price, StringFormat=R$ {0:F2}}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        Width="96"
                                        Command="{Binding DataContext.AdicionarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="Adicionar"
                                        Style="{StaticResource PrimaryButton}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Row="1" Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Carrinho" />
                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrandBlue}" Text="{Binding TotalTexto}" />
                        <TextBlock Margin="0,0,0,12" Foreground="{StaticResource TextMuted}" Text="{Binding SubtotalTexto, StringFormat=Subtotal: {0}}" />
                        <Button Margin="0,0,0,8" Click="BtnFinalizar_Click" Content="Ir para pagamento" Style="{StaticResource PrimaryButton}" />
                        <Button Click="BtnCancelar_Click" Content="Cancelar venda" Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </Border>
                <ListBox Margin="0,8,0,0" ItemsSource="{Binding Carrinho}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Background="White" BorderBrush="#E2E6EC" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:ProductThumb Width="40" Height="40" ImagePath="{Binding ImagePath}" ProductName="{Binding Name}" />
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Total, StringFormat=R$ {0:F2}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Width="32" Command="{Binding DataContext.DiminuirCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="-" Style="{StaticResource GhostButton}" />
                                        <TextBlock Width="28" VerticalAlignment="Center" Text="{Binding Quantity, StringFormat={}{0:0}}" TextAlignment="Center" />
                                        <Button Width="32" Command="{Binding DataContext.AumentarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="+" Style="{StaticResource GhostButton}" />
                                        <Button Width="32" Margin="6,0,0,0" Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="x" Style="{StaticResource DangerButton}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
