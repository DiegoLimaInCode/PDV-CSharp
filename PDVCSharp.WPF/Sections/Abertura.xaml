<UserControl
    x:Class="PDVCSharp.WPF.Sections.Abertura"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PDVCSharp.WPF.Controls">
    <DockPanel Background="{StaticResource PageBackground}">
        <controls:AppHeader Title="Abertura de caixa" DockPanel.Dock="Top" />
        <Grid Margin="24">
            <Border
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}" Text="SUPERMARKET" />
                    <TextBlock Margin="0,4,0,8" FontSize="28" FontWeight="Bold" Text="Abertura de caixa" />
                    <TextBlock Margin="0,0,0,4" Foreground="{StaticResource TextMuted}">
                        <Run Text="Operador: " />
                        <Run FontWeight="SemiBold" Text="{Binding OperatorName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,0,0,18" Foreground="{StaticResource TextMuted}">
                        <Run Text="Data: " />
                        <Run FontWeight="SemiBold" Text="{Binding Today, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy}}" />
                    </TextBlock>

                    <TextBlock Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold" Text="Valor de abertura" />
                    <Grid>
                        <TextBox
                            x:Name="PlaceHolder_ValueBox"
                            CaretBrush="Black"
                            Foreground="Transparent"
                            Style="{StaticResource FieldBox}"
                            TextChanged="PlaceHolder_ValueBox_TextChanged" />
                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#99000000"
                            IsHitTestVisible="False">
                            <Run Text="R$ " />
                            <Run x:Name="TxtValorEntrada" Text="0,00" />
                        </TextBlock>
                    </Grid>
                    <Button
                        x:Name="ButtonConfirm"
                        Margin="0,16,0,0"
                        Click="BtnConfirmar_Click"
                        Content="Confirmar e abrir caixa"
                        Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Border>

            <StackPanel
                x:Name="AdminOperatorArea"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="320"
                Visibility="Collapsed">
                <Button
                    Click="BtnToggleOperatorPanel_Click"
                    Content="Gerenciar operadores"
                    Style="{StaticResource GhostButton}" />
                <Border
                    x:Name="AdminOperatorPanel"
                    Margin="0,12,0,0"
                    Style="{StaticResource Card}"
                    Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="Bold" Text="Cadastrar operador" />
                        <TextBlock Margin="0,12,0,6" FontSize="12" Text="Nome" />
                        <TextBox x:Name="TxtOperatorName" Style="{StaticResource FieldBox}" />
                        <TextBlock Margin="0,12,0,6" FontSize="12" Text="Login" />
                        <TextBox x:Name="TxtOperatorLogin" Style="{StaticResource FieldBox}" />
                        <TextBlock Margin="0,12,0,6" FontSize="12" Text="Cargo" />
                        <ComboBox x:Name="CmbOperatorCargo" Height="44" SelectedIndex="0">
                            <ComboBoxItem Content="Caixa" Tag="Caixa" />
                            <ComboBoxItem Content="Administrador" Tag="Administrador" />
                        </ComboBox>
                        <TextBlock Margin="0,12,0,6" FontSize="12" Text="Senha" />
                        <PasswordBox x:Name="PwdOperator" Style="{StaticResource FieldPassword}" />
                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                            <Button Width="90" Margin="0,0,8,0" Click="BtnCloseOperatorPanel_Click" Content="Fechar" Style="{StaticResource GhostButton}" />
                            <Button x:Name="BtnSaveOperator" Width="90" Margin="0,0,8,0" Click="BtnSaveOperator_Click" Content="Salvar" Style="{StaticResource PrimaryButton}" />
                            <Button Width="110" Click="BtnToggleDeleteOperatorPanel_Click" Content="Excluir" Style="{StaticResource DangerButton}" />
                        </StackPanel>
                        <Border
                            x:Name="DeleteOperatorPanel"
                            Margin="0,14,0,0"
                            Padding="10"
                            Background="#F7F7F7"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Selecione o usuário" />
                                <ComboBox x:Name="CmbUsersToDelete" Height="36" Margin="0,10,0,0" />
                                <Button
                                    Width="120"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Click="BtnDeleteOperator_Click"
                                    Content="Deletar"
                                    Style="{StaticResource DangerButton}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
