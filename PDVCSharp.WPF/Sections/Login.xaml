<UserControl
    x:Class="PDVCSharp.WPF.Sections.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PDVCSharp.WPF.Controls">
    <DockPanel Background="{StaticResource PageBackground}">
        <controls:AppHeader Title="Acesso do operador" DockPanel.Dock="Top" />
        <Border
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}" Text="SUPERMARKET" />
                <TextBlock Margin="0,4,0,6" FontSize="28" FontWeight="Bold" Text="Entrar no caixa" />
                <TextBlock Margin="0,0,0,20" Foreground="{StaticResource TextMuted}" Text="Use o login do operador para abrir o turno." />

                <TextBlock Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold" Text="Usuário" />
                <TextBox
                    KeyDown="Campo_KeyDown"
                    Style="{StaticResource FieldBox}"
                    Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,14,0,6" FontSize="12" FontWeight="SemiBold" Text="Senha" />
                <Grid>
                    <PasswordBox
                        x:Name="TxtPassword"
                        KeyDown="Campo_KeyDown"
                        Style="{StaticResource FieldPassword}" />
                    <TextBox
                        x:Name="TxtPasswordVisible"
                        KeyDown="Campo_KeyDown"
                        Style="{StaticResource FieldBox}"
                        Visibility="Collapsed" />
                </Grid>
                <CheckBox
                    Margin="0,10,0,16"
                    Content="Mostrar senha"
                    Checked="TogglePassword_Checked"
                    Unchecked="TogglePassword_Unchecked" />
                <TextBlock
                    Margin="0,0,0,12"
                    Foreground="{StaticResource Danger}"
                    Text="{Binding Erro}"
                    TextWrapping="Wrap" />
                <Button Click="Button_Click" Content="Entrar" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
